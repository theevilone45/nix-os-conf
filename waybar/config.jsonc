// -*- mode: jsonc -*-
{
  // "layer": "top", // Waybar at top layer
  // "position": "bottom", // Waybar position (top|bottom|left|right)
  // "width": 1280, // Waybar width
  "spacing": 4, // Gaps between modules (4px)
  "margin-left": 10,
  "margin-right": 10,
  // Choose the order of the modules
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": [
    "network",
    "cpu",
    "temperature",
    "memory",
    "custom/bluetooth",
    "custom/audio",
    "clock",
    "custom/power",
  ],
  // Modules configuration
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{name}: {icon}",
    "format-icons": {
      "active": "🟢",
      "default": "⚪",
      "inactive": "⚫",
      "urgent": "🔴",
    },
  },
  "hyprland/window": {
    "swap-icon-label": true,
  },
  "clock": {
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%Y-%m-%d}",
  },
  "cpu": {
    "format": "CPU {usage}%",
    "tooltip": false,
  },
  "temperature": {
    "hwmon-path": "/sys/devices/pci0000:00/0000:00:18.3/hwmon/hwmon1/temp1_input",
    "format": "{temperatureC}°C",
    "critical-threshold": 80,
    "format-critical": "{temperatureC}°C 🔥",
  },
  "memory": {
    "format": "RAM {}%",
  },
  "network": {
    "format-ethernet": "Network 🟢",
    "format-disconnected": "Network 🔴",
  },
  "custom/power": {
    "format": "Power",
    "tooltip": false,
    "on-click": "~/.config/waybar/power_menu.sh",
  },
  "custom/audio": {
    "exec": "~/nixos/waybar/audio_status.sh",
    "return-type": "json",
    "interval": 5,
    "signal": 8,
    "on-click": "~/nixos/waybar/audio_menu.sh",
  },
  "custom/bluetooth": {
    "format": "Bluetooth",
    "tooltip": false,
    "on-click": "~/.config/waybar/bluetooth_menu.sh",
  },
}
